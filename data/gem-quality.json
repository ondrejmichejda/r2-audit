{
  "source": "manual-rules",
  "rules": [
    {
      "label": "primary-with-tertiary",
      "quality": "accepted",
      "match": {
        "textIncludes": "23 Primary / +0.15%"
      }
    },
    {
      "label": "primary-with-mana",
      "quality": "accepted",
      "match": {
        "textIncludes": "23 Primary / +1% Maximum Mana per unique Midnight gem color"
      }
    },
    {
      "label": "primary",
      "quality": "accepted",
      "match": {
        "textIncludes": "32 Primary"
      }
    },
    {
      "label": "secondary-mastery",
      "quality": "accepted",
      "match": {
        "regex": "\\b(16|17)\\s+(mastery|mast)\\b"
      }
    },
    {
      "label": "secondary-haste",
      "quality": "accepted",
      "match": {
        "regex": "\\b(16|17)\\s+(haste|hast)\\b"
      }
    },
    {
      "label": "secondary-critical",
      "quality": "accepted",
      "match": {
        "regex": "\\b(16|17)\\s+(critical|crit)\\b"
      }
    },
    {
      "label": "secondary-versatility",
      "quality": "accepted",
      "match": {
        "regex": "\\b(16|17)\\s+(versatility|vers)\\b"
      }
    }
  ],
  "default": {
    "quality": "rejected"
  }
}
