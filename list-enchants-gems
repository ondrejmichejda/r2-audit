	});
});
document.addEventListener('DOMContentLoaded', () => {
	const avatar = document.querySelector('.user-items:not(.user-items-mobile)');
	const dropdown = document.querySelector('.account-dropdown');

	if (! avatar) {
		return;
	}

	// Toggle dropdown when avatar is clicked
	avatar.addEventListener('click', (e) => {
		e.stopPropagation(); // Prevent this click from triggering the document click handler
		dropdown.classList.toggle('shown');
	});

	// Close dropdown when clicking anywhere else on the page
	document.addEventListener('click', (e) => {
		// Check if the click was outside both the avatar and dropdown
		if (! avatar.contains(e.target) && ! dropdown.contains(e.target)) {
			dropdown.classList.remove('shown');
		}
	});
});
