<script>
	const dropdownItem = document.querySelector('.wow-navbar .nav-item-dropdown'),
		dropdownInsert = dropdownItem.querySelector('.nav-submenu ul');

	[...document.querySelectorAll('.wow-navbar .nav > .nav-item:not(.nav-item-dropdown)')].map((el, i) => {
		el.dataset.index = i;
	})

	const handleNav = () => {
		let hasMenu = false;
		[...dropdownInsert.querySelectorAll('.nav-item-dropdown > .nav-submenu > ul > li')].map(el => {
			const before = document.querySelector(`.wow-navbar .nav > .nav-item[data-index="${el.dataset.index-1}"]`);
			if (before) {
				before.after(el);
			} else {
				document.querySelector('.nav-icons-menu').after(el);
			}
		});
		const navbar = document.querySelector('.wow-navbar');
		const nav = navbar.querySelector('.nav');
		// Hide dropdown first so it doesn't affect width
		dropdownItem.classList.add('hidden');
		const maxRight = navbar.offsetWidth;
		// If nav is overflowing, enable dropdown
		if (nav.scrollWidth > navbar.offsetWidth) {
			dropdownItem.classList.remove('hidden');
		}
		[...document.querySelectorAll('.wow-navbar .nav > .nav-item:not(.nav-item-dropdown)')].reverse().map(el => {
			if (dropdownItem.offsetLeft + dropdownItem.offsetWidth > maxRight) {
				dropdownInsert.prepend(el);
				hasMenu = true;
			}
		});
		if (! hasMenu) {
			dropdownItem.classList.add('hidden');
		}
	}
	handleNav();

	let resizeTimeout;
	window.addEventListener('resize', () => {
		if (resizeTimeout) {
			clearTimeout(resizeTimeout);
			resizeTimeout = null;
		}
		resizeTimeout = setTimeout(handleNav, 50);
	});
	document.addEventListener('DOMContentLoaded', () => {
		handleNav();
		setTimeout(handleNav, 200);
		setTimeout(handleNav, 500);
	});

	dropdownItem.addEventListener('click', () => {
		dropdownItem.classList.toggle('active');
	});
	document.addEventListener('click', (e) => {
		if (! e.target.matches('.wow-navbar .nav-item-dropdown *')) {
			dropdownItem.classList.remove('active');
		}
	});
	const dropdownItems = [...document.querySelectorAll('.wow-nav .nav-category-dropdown')];
	dropdownItems.map(el => {
		el.addEventListener('click', () => {
			if (window.screen.width > 1199) {
				return;
			}
			el.classList.toggle('active');
		});
	});
	document.addEventListener('click', (e) => {
		if (! e.target.matches('.wow-nav .nav-category-dropdown *')) {
			dropdownItems.map(el => {
				el.classList.remove('active');
			});
		}
	});
</script>
